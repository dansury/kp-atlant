# ТОЛЬКО корневой config.php — он с секретами. Без ведущего слэша это правило
# ловило `config.php` на любой глубине, из-за чего
# `bitrix-module/atlant.kpsync/lib/config.php` молча не попал в репозиторий,
# а модуль на сайте падал на `Failed opening required …/lib/config.php`.
/config.php
data/kp.db
data/secret.key
data/auto-pull.json
data/auto-pull.json.lock
data/kp.db-wal
data/kp.db-shm
data/kp/
# Фото страницы-редактора КП (модуль 045)
data/kp_img/
data/tmp/
storage/signatures/*
!storage/signatures/.gitkeep
storage/logo/*
!storage/logo/.gitkeep
storage/mbox/*
!storage/mbox/.gitkeep
storage/attachments/*
!storage/attachments/.gitkeep
storage/invoices/*
!storage/invoices/.gitkeep
storage/product_images/*
!storage/product_images/.gitkeep
# Файлы, которые менеджер приложил к письму и ещё не отправил (модуль 023)
storage/outbox/*
!storage/outbox/.gitkeep
# Файлы обращений в поддержку (модуль 034): их копия уезжает в issue, оригинал
# живёт здесь и переживает деплой
storage/support/*
!storage/support/.gitkeep
# Tone of Voice, отредактированный в панели (модуль 022): живёт в storage/,
# потому что деплой перезаписывает файлы репозитория
storage/tov.md
.DS_Store

# graphify local-only artifacts (cache, manifest, labels) — graph.json and GRAPH_REPORT.md are committed
graphify-out/cache/
graphify-out/manifest.json
graphify-out/.graphify_labels.json
graphify-out/.graphify_root
graphify-out/cost.json
